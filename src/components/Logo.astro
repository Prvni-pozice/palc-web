---
// Logotyp PALC dle design systému (guidelines/logo.html):
// logo-primary.png = navy+červená na světlé, logo-white.png = bílá+červená na navy.
// Zdroj: assets/* z design projektu (přeneseno 17. 8. 2026, CRC ověřeno).
interface Props {
  inverse?: boolean;
  height?: number;
}
const { inverse = false, height = 26 } = Astro.props;
const src = inverse ? '/img/logo-white.png' : '/img/logo-primary.png';
---

<img src={src} alt="PALC" height={height} class="logo" />

<style>
  .logo { display: block; width: auto; }
</style>
