---
// DOČASNÉ SVG logo — wordmark „PAL" + C z motivu (assets/motif-c.svg).
// Ostrá loga (logo-primary.png / logo-white.png) nelze přenést z design projektu
// (limit 256 KiB / binárky) — klient/Zdeněk je nahraje přes GitHub, pak nahradit <img>.
interface Props {
  inverse?: boolean;
  height?: number;
}
const { inverse = false, height = 26 } = Astro.props;
const navy = inverse ? '#FFFFFF' : '#133559';
---

<span class="logo" aria-label="PALC">
  <svg
    height={height}
    viewBox="0 0 224 80"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-hidden="true"
  >
    <text
      x="0"
      y="66"
      font-family="Jost, system-ui, sans-serif"
      font-weight="600"
      font-size="80"
      letter-spacing="4"
      fill={navy}>PAL</text>
    <!-- C = mezikruží s červeným segmentem nahoře vpravo (motif-c.svg, zmenšené na výšku verzálek) -->
    <g transform="translate(157, 5) scale(0.32)" fill="none" stroke-linecap="butt">
      <path d="M 172.1 141.6 A 80 80 0 1 1 171.1 56.1" stroke={navy} stroke-width="34"></path>
      <path d="M 138.6 29.2 A 80 80 0 0 1 166.4 48.5" stroke="#FF464A" stroke-width="34"></path>
    </g>
  </svg>
</span>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo svg { display: block; }
</style>
