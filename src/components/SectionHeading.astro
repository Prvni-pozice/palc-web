---
// SectionHeading dle DS: červený overline verzálkami + h2 + lead
interface Props {
  overline?: string;
  title: string;
  lead?: string;
  inverse?: boolean;
  align?: 'left' | 'center';
}
const { overline, title, lead, inverse = false, align = 'left' } = Astro.props;
---

<div class={`sh ${inverse ? 'sh--inverse' : ''} ${align === 'center' ? 'sh--center' : ''}`}>
  {overline && <p class="sh__overline">{overline}</p>}
  <h2 class="sh__title">{title}</h2>
  {lead && <p class="sh__lead">{lead}</p>}
</div>

<style>
  .sh { max-width: 720px; }
  .sh--center { text-align: center; margin: 0 auto; }
  .sh__overline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-accent);
    margin: 0 0 14px;
  }
  .sh__title { font-size: var(--text-2xl); }
  .sh--inverse .sh__title { color: #fff; }
  .sh__lead {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-body);
    margin: 16px 0 0;
  }
  .sh--inverse .sh__lead { color: var(--text-inverse-muted); }
  @media (max-width: 720px) {
    .sh__title { font-size: var(--text-xl); }
  }
</style>
