---
// Grafika karet služeb — schémata ve stylu technické (P&ID) dokumentace.
// Záměrně NE ikony (DS je zakazuje: žádná kapka/plamínek/klíč) — místo toho
// výkresový jazyk: tenké linky, armatury, šipky proudění, červená jen jako akcent.
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<div class="sg" aria-hidden="true">
  {kind === 'zdravotechnika' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- páteřní rozvod vody s odbočkami a armaturou -->
      <path d="M8 28 H272" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M60 28 V58 H100" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M180 28 V58 H220" stroke="#C2CDD6" stroke-width="1.5" />
      <circle cx="60" cy="28" r="3" fill="#133559" />
      <circle cx="180" cy="28" r="3" fill="#133559" />
      <!-- ventil (bowtie) -->
      <path d="M118 20 L138 36 V20 L118 36 Z" stroke="#133559" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M128 28 V12" stroke="#133559" stroke-width="1.5" />
      <path d="M122 12 H134" stroke="#FF464A" stroke-width="2.5" />
      <!-- výtoky -->
      <path d="M100 52 V64 M220 52 V64" stroke="#133559" stroke-width="1.5" />
      <path d="M96 58 H104 M216 58 H224" stroke="#C2CDD6" stroke-width="1.5" />
    </svg>
  )}
  {kind === 'vytapeni' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- kotel + otopný okruh: červená = přívod, šedá = zpátečka -->
      <rect x="16" y="16" width="44" height="40" stroke="#133559" stroke-width="1.5" />
      <path d="M28 46 Q33 38 38 46 Q43 54 48 46" stroke="#133559" stroke-width="1.5" />
      <path d="M60 26 H240 V46" stroke="#FF464A" stroke-width="2" />
      <path d="M60 46 H196" stroke="#C2CDD6" stroke-width="1.5" />
      <!-- otopné těleso -->
      <rect x="216" y="46" width="48" height="14" stroke="#133559" stroke-width="1.5" />
      <path d="M224 46 V60 M232 46 V60 M240 46 V60 M248 46 V60 M256 46 V60" stroke="#133559" stroke-width="1" />
      <!-- šipka proudění -->
      <path d="M130 26 l-6 -4 M130 26 l-6 4" stroke="#FF464A" stroke-width="1.5" transform="rotate(180 127 26)" />
    </svg>
  )}
  {kind === 'vzduchotechnika' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- VZT potrubí + rotor jednotky, šipky proudění -->
      <path d="M8 24 H120 M8 48 H120" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M120 24 L150 14 M120 48 L150 58" stroke="#C2CDD6" stroke-width="1.5" />
      <circle cx="170" cy="36" r="22" stroke="#133559" stroke-width="1.5" />
      <path d="M170 36 C162 28 162 20 170 16 M170 36 C178 44 178 52 170 56 M170 36 C158 40 152 38 150 30 M170 36 C182 32 188 34 190 42" stroke="#133559" stroke-width="1.5" />
      <circle cx="170" cy="36" r="3" fill="#133559" />
      <path d="M204 36 H264 M252 30 l12 6 -12 6" stroke="#FF464A" stroke-width="2" stroke-linejoin="round" />
      <path d="M28 18 l8 -6 M56 18 l8 -6" stroke="#C2CDD6" stroke-width="1.5" />
    </svg>
  )}
  {kind === 'chlazeni-a-klimatizace' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- chladicí okruh: výparník ↔ kondenzátor, kompresor -->
      <rect x="16" y="20" width="56" height="32" stroke="#133559" stroke-width="1.5" />
      <path d="M22 36 l8 -8 8 8 8 -8 8 8 8 -8" stroke="#133559" stroke-width="1.5" />
      <rect x="208" y="20" width="56" height="32" stroke="#133559" stroke-width="1.5" />
      <path d="M214 36 l8 -8 8 8 8 -8 8 8 8 -8" stroke="#FF464A" stroke-width="1.5" />
      <path d="M72 28 H208" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M72 46 H128 M152 46 H208" stroke="#C2CDD6" stroke-width="1.5" />
      <!-- kompresor -->
      <circle cx="140" cy="46" r="12" stroke="#133559" stroke-width="1.5" />
      <path d="M134 40 L146 52 M134 52 L146 40" stroke="#133559" stroke-width="1" />
    </svg>
  )}
  {kind === 'plyn' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- plynovod: uzávěr + manometr + regulátor -->
      <path d="M8 44 H272" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M70 36 L94 52 V36 L70 52 Z" stroke="#133559" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M82 44 V26 H74 M90 26 H74" stroke="#133559" stroke-width="1.5" />
      <!-- manometr -->
      <circle cx="170" cy="28" r="14" stroke="#133559" stroke-width="1.5" />
      <path d="M170 44 V28" stroke="#133559" stroke-width="1.5" />
      <path d="M170 28 L179 20" stroke="#FF464A" stroke-width="2" />
      <path d="M160 24 l3 3 M180 36 l-3 -2" stroke="#C2CDD6" stroke-width="1" />
      <!-- odběr -->
      <path d="M236 44 V24 H252" stroke="#133559" stroke-width="1.5" />
    </svg>
  )}
  {kind === 'specializovane-technologie' && (
    <svg viewBox="0 0 280 72" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- jádrový vrt (soustředné kružnice, echo motivu C) + řezová rovina -->
      <circle cx="70" cy="36" r="26" stroke="#C2CDD6" stroke-width="1.5" />
      <circle cx="70" cy="36" r="17" stroke="#133559" stroke-width="1.5" />
      <path d="M70 19 A17 17 0 0 1 84 28" stroke="#FF464A" stroke-width="3" />
      <circle cx="70" cy="36" r="2.5" fill="#133559" />
      <path d="M30 66 L110 6" stroke="#C2CDD6" stroke-width="1" stroke-dasharray="4 4" />
      <!-- podtlakové odvodnění: střešní vpust + svod -->
      <path d="M150 24 H270" stroke="#133559" stroke-width="1.5" />
      <path d="M196 24 L204 32 H188 Z" fill="#133559" />
      <path d="M196 32 V58 H240" stroke="#C2CDD6" stroke-width="1.5" />
      <path d="M228 52 l12 6 -12 6" stroke="#FF464A" stroke-width="2" stroke-linejoin="round" fill="none" />
    </svg>
  )}
</div>

<style>
  .sg { margin-bottom: 6px; }
  .sg svg { display: block; width: 100%; height: 64px; }
</style>
