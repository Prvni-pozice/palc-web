---
// Homepage dle DS ui_kits/web/Home.jsx: hero → důkaz čísly → služby → realizace → proces → zázemí → CTA
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MetaLine from '../components/MetaLine.astro';
import Button from '../components/Button.astro';
import Stat from '../components/Stat.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { SERVICES } from '../data/services.js';
import { PROJECTS } from '../data/projects.js';
import { PROCESS } from '../data/process.js';
---

<Base
  title="PALČ — Technologie, které drží budovy v chodu"
  description="Komplexní realizace technických zařízení budov pro developery, stavební společnosti, průmysl a veřejné objekty."
  active="Úvod"
  headerOverlay
>
  <!-- 1. Hero: slider 2 slidů — budova + heslo (fotky = DEMO Unsplash, nahradí reálné stavby) -->
  <div class="hero" data-hero>
    <div class="hero__slide is-active" data-slide style="background-image: url('/img/hero/hero-1.jpg');">
      <div class="hero__shade"></div>
      <div class="hero__content">
        <h1 class="hero__title">Technologie, které drží budovy v&nbsp;chodu.</h1>
        <p class="hero__lead">Komplexní realizace technických zařízení budov pro developery, stavební společnosti, průmysl a&nbsp;veřejné objekty.</p>
        <div class="hero__cta">
          <Button variant="primary" size="lg" href="/realizace/" arrow>Prohlédnout realizace</Button>
          <Button variant="inverse" size="lg" href="/poptavka/">Poptat projekt</Button>
        </div>
      </div>
    </div>
    <div class="hero__slide" data-slide style="background-image: url('/img/hero/hero-2.jpg');">
      <div class="hero__shade"></div>
      <div class="hero__content">
        <p class="hero__eyebrow">Vidíte budovu.</p>
        <h2 class="hero__title">My vidíme, co ji drží v&nbsp;chodu.</h2>
        <p class="hero__lead">Voda, teplo, vzduch, chlad i&nbsp;plyn — pod jednou odpovědností, od projektu po servis.</p>
        <div class="hero__cta">
          <Button variant="primary" size="lg" href="/sluzby/" arrow>Co umíme</Button>
          <Button variant="inverse" size="lg" href="/poptavka/">Poptat projekt</Button>
        </div>
      </div>
    </div>
    <div class="hero__dots" role="tablist" aria-label="Slidy">
      <button type="button" class="hero__dot is-active" data-dot="0" aria-label="Slide 1"></button>
      <button type="button" class="hero__dot" data-dot="1" aria-label="Slide 2"></button>
    </div>
  </div>

  <!-- 2. Důkaz během 10 sekund: čísla + loga klientů -->
  <Section pad="72px 40px">
    <div class="stats">
      <Stat value="7 let" label="Zkušeností" />
      <Stat value="35" label="Realizací" />
      <Stat value="18" label="Odborníků" />
      <Stat value="ČR" label="Praha a okolí" />
    </div>
    <div class="clients">
      <MetaLine class="clients__label">Důvěřují nám</MetaLine>
      {[1, 2, 3, 4, 5].map(() => <div class="clients__logo">LOGO KLIENTA</div>)}
    </div>
  </Section>

  <!-- 3. Co umíme: 6 hlavních služeb -->
  <Section bg="var(--palc-grey-50)">
    <SectionHeading
      overline="Co umíme"
      title="Kompletní technické zařízení budov"
      lead="Šest hlavních oblastí. Jedna odpovědnost za funkční celek."
    />
    <div class="grid3 mt48">
      {SERVICES.map((s) => (
        <ServiceCard title={s.title} description={s.desc} href={`/sluzby/${s.slug}/`} graphic={s.slug} />
      ))}
    </div>
  </Section>

  <!-- 4. Vybrané realizace -->
  <Section>
    <div class="split">
      <SectionHeading overline="Vybrané realizace" title="Vidíte budovu. My vidíme, co ji drží v chodu." />
      <Button variant="outline" href="/realizace/" arrow>Všechny realizace</Button>
    </div>
    <div class="grid3 mt48">
      {PROJECTS.slice(0, 3).map((p) => (
        <ProjectCard title={p.title} place={p.place} year={p.year} tags={p.tags} scope={p.scope} image={p.image} href={`/realizace/${p.id}/`} />
      ))}
    </div>
  </Section>

  <!-- 5. Proces realizace 01–06 -->
  <Section bg="var(--surface-dark)">
    <SectionHeading inverse overline="Proces realizace" title="Od zadání po servis" />
    <div class="proc mt56">
      {PROCESS.map(([n, t, d]) => (
        <div class="proc__step">
          <span class="proc__num">{n}</span>
          <h3 class="proc__title">{t}</h3>
          <p class="proc__desc">{d}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 6. Zázemí -->
  <Section>
    <div class="zazemi">
      <ImagePlaceholder label="Areál / hala — dodá klient" ratio="4 / 3" />
      <div>
        <SectionHeading overline="Zázemí" title="Máme zázemí pro velké realizace" />
        <ul class="zazemi__list">
          {[
            'Vlastní technické a skladové zázemí',
            'Vozový park a vybavení montážních týmů',
            'Sklad materiálu a příprava zakázek',
            'Koordinace více profesí pod jednou střechou',
          ].map((x) => (
            <li class="zazemi__item"><span class="zazemi__dash"></span>{x}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- 7. B2B poptávka CTA -->
  <Section bg="var(--surface-darker)" pad="88px 40px">
    <div class="cta">
      <div>
        <h2 class="cta__title">Máte projekt? Pošlete nám podklady.</h2>
        <p class="cta__lead">Projektová dokumentace nebo výkaz výměr stačí. Ozveme se s technickým řešením.</p>
      </div>
      <Button variant="primary" size="lg" href="/poptavka/" arrow>Poptat realizaci</Button>
    </div>
  </Section>
</Base>

<style>
  .hero { position: relative; background: var(--palc-navy-950); display: grid; }
  .hero__slide {
    grid-area: 1 / 1;
    position: relative;
    background-size: cover;
    background-position: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms var(--ease-out), visibility 0s 600ms;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 600ms var(--ease-out);
    z-index: 1;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 29, 49, .72) 0%, rgba(10, 29, 49, .25) 45%, rgba(10, 29, 49, .78) 100%);
  }
  .hero__content {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 200px 40px 120px;
  }
  .hero__eyebrow {
    color: rgba(255, 255, 255, .75);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .hero__title { color: #fff; font-size: var(--text-4xl); max-width: 820px; font-weight: 600; }
  .hero__lead { color: rgba(255, 255, 255, .8); font-size: var(--text-md); max-width: 560px; margin-top: 20px; }
  .hero__cta { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; }
  .hero__dots {
    position: absolute;
    bottom: 36px;
    left: 0;
    right: 0;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 10px;
    z-index: 2;
  }
  .hero__dot {
    width: 36px;
    height: 3px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, .32);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .hero__dot:hover { background: rgba(255, 255, 255, .6); }
  .hero__dot.is-active { background: var(--accent); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .clients {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }
  .clients :global(.clients__label) { margin-right: 12px; }
  .clients__logo {
    width: 120px;
    height: 40px;
    background: var(--palc-grey-100);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--palc-grey-500);
  }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .mt48 { margin-top: 48px; }
  .mt56 { margin-top: 56px; }
  .split { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }

  .proc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 32px; }
  .proc__step { border-top: 1px solid var(--border-inverse); padding-top: 18px; }
  .proc__num { font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--text-accent); }
  .proc__title { color: #fff; font-size: 19px; margin: 8px 0 6px; }
  .proc__desc { color: var(--text-inverse-muted); font-size: 14px; }

  .zazemi { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .zazemi__list { margin: 24px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .zazemi__item { display: flex; gap: 12px; align-items: baseline; font-size: 15px; color: var(--text-body); }
  .zazemi__dash { width: 16px; height: 3px; background: var(--accent); flex-shrink: 0; transform: translateY(-3px); }

  .cta { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .cta__title { color: #fff; font-size: var(--text-2xl); }
  .cta__lead { color: var(--text-inverse-muted); margin-top: 10px; font-size: 16px; }

  @media (max-width: 960px) {
    .grid3, .proc { grid-template-columns: repeat(2, 1fr); }
    .zazemi { grid-template-columns: 1fr; gap: 32px; }
    .hero__title { font-size: var(--text-3xl); }
    .hero__content { padding: 160px 40px 96px; }
  }
  @media (max-width: 640px) {
    .grid3, .proc { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .hero__title { font-size: var(--text-2xl); }
    .hero__content { padding: 140px 20px 80px; }
    .hero__dots { padding: 0 20px; bottom: 28px; }
  }
</style>

<script>
  // Hero slider: auto-rotace 6 s, tečky, pauza při hoveru
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function go(i: number) {
    current = i % slides.length;
    slides.forEach((s, n) => s.classList.toggle('is-active', n === current));
    dots.forEach((d, n) => d.classList.toggle('is-active', n === current));
  }
  function start() {
    stop();
    timer = setInterval(() => go(current + 1), 6000);
  }
  function stop() {
    if (timer) clearInterval(timer);
  }

  dots.forEach((d, n) => d.addEventListener('click', () => { go(n); start(); }));
  hero?.addEventListener('mouseenter', stop);
  hero?.addEventListener('mouseleave', start);
  if (slides.length > 1) start();
</script>
