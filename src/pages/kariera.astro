---
// Kariéra — kostra (DS: záměrně prázdné, čeká na pozice od klienta)
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MetaLine from '../components/MetaLine.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site.js';
---

<Base
  title="Kariéra | PALČ"
  description="Přidejte se k PALČ — montážní týmy, přípraváři, technici TZB. Otevřené pozice doplníme."
  active="Kariéra"
>
  <Section bg="var(--surface-dark)" pad="88px 40px">
    <MetaLine accent>Kariéra</MetaLine>
    <h1 class="page-h1">Stavíme týmy pro velké realizace.</h1>
    <p class="page-lead">Otevřené pozice doplníme podle podkladů klienta. Zájem o práci u PALČ nám můžete poslat rovnou.</p>
    <div class="mt32">
      <Button variant="primary" size="lg" href={`mailto:${SITE.email}`} arrow>Napsat nám</Button>
    </div>
  </Section>

  <Section>
    <p class="empty">Aktuálně zde nejsou vypsané žádné pozice.</p>
  </Section>
</Base>

<style>
  .page-h1 { color: #fff; font-size: var(--text-3xl); margin-top: 14px; max-width: 760px; }
  .page-lead { color: var(--text-inverse-muted); font-size: var(--text-md); max-width: 620px; margin-top: 18px; }
  .mt32 { margin-top: 32px; }
  .empty { color: var(--text-muted); }
  @media (max-width: 960px) {
    .page-h1 { font-size: var(--text-2xl); }
  }
</style>
