---
// Realizace dle DS ui_kits/web/Realizace.jsx: dvojí filtr (typ stavby × profese), klientský JS
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import MetaLine from '../../components/MetaLine.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECTS, PROJECT_TYPES } from '../../data/projects.js';
import { PROFESSIONS } from '../../data/services.js';
---

<Base
  title="Realizace — stavby, které držíme v chodu | PALČ"
  description="Reference PALČ: administrativní budovy, haly, bytové projekty, retail, veřejné stavby. Každá důležitá reference je samostatná case study."
  active="Realizace"
>
  <Section pad="72px 40px 40px">
    <SectionHeading
      overline="Realizace"
      title="Stavby, které držíme v chodu"
      lead="Každá důležitá reference je samostatná case study — s rozsahem dodávky a realizovanými profesemi."
    />
    <div class="filters">
      <div class="filters__row">
        <MetaLine class="filters__label">Typ stavby</MetaLine>
        {PROJECT_TYPES.map((t) => (
          <button type="button" class="tag filter-tag" data-filter="type" data-value={t}>{t}</button>
        ))}
      </div>
      <div class="filters__row">
        <MetaLine class="filters__label">Profese</MetaLine>
        {PROFESSIONS.map((p) => (
          <button type="button" class="tag filter-tag" data-filter="prof" data-value={p}>{p}</button>
        ))}
      </div>
    </div>
  </Section>

  <Section bg="var(--palc-grey-50)" pad="56px 40px 96px">
    <div class="grid3" data-projects>
      {PROJECTS.map((p) => (
        <div class="grid3__item" data-type={p.type} data-tags={p.tags.join('|')}>
          <ProjectCard title={p.title} place={p.place} year={p.year} tags={p.tags} scope={p.scope} image={p.image} href={`/realizace/${p.id}/`} />
        </div>
      ))}
    </div>
    <p class="empty" data-empty hidden>Tomuto filtru zatím neodpovídá žádná realizace.</p>
  </Section>
</Base>

<script>
  // Filtry: 1 aktivní typ + 1 aktivní profese, opakovaný klik = zrušení
  const state: { type: string | null; prof: string | null } = { type: null, prof: null };
  const tags = document.querySelectorAll<HTMLButtonElement>('.filter-tag');
  const items = document.querySelectorAll<HTMLElement>('[data-projects] .grid3__item');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply() {
    let visible = 0;
    items.forEach((it) => {
      const okType = !state.type || it.dataset.type === state.type;
      const okProf = !state.prof || (it.dataset.tags || '').split('|').includes(state.prof);
      const show = okType && okProf;
      it.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    tags.forEach((t) => {
      const key = t.dataset.filter as 'type' | 'prof';
      t.classList.toggle('tag--active', state[key] === t.dataset.value);
    });
  }

  tags.forEach((t) => {
    t.addEventListener('click', () => {
      const key = t.dataset.filter as 'type' | 'prof';
      state[key] = state[key] === t.dataset.value ? null : (t.dataset.value ?? null);
      apply();
    });
  });
</script>

<style>
  .filters { display: flex; flex-direction: column; gap: 12px; margin-top: 40px; }
  .filters__row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .filters__row :global(.filters__label) { width: 130px; flex-shrink: 0; }
  .filter-tag { cursor: pointer; }
  .filter-tag:hover { border-color: var(--palc-navy-900); color: var(--palc-navy-900); }
  .filter-tag.tag--active:hover { color: #fff; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .empty { color: var(--text-muted); }
  @media (max-width: 960px) {
    .grid3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .grid3 { grid-template-columns: 1fr; }
  }
</style>
