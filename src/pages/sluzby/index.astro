---
// Služby dle DS ui_kits/web/Sluzby.jsx: navy hero + tagy profesí → hlavní profese → specializace
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import MetaLine from '../../components/MetaLine.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { SERVICES, PROFESSIONS } from '../../data/services.js';

const mainServices = SERVICES.filter((s) => s.slug !== 'specializovane-technologie');
---

<Base
  title="Služby — kompletní technické zařízení budov | PALČ"
  description="Jeden dodavatel a jedna odpovědnost za všechny technické profese stavby — zdravotechnika, vytápění, vzduchotechnika, chlazení, plyn."
  active="Služby"
>
  <Section bg="var(--surface-dark)" pad="88px 40px">
    <MetaLine accent>Služby</MetaLine>
    <h1 class="page-h1">Kompletní technické zařízení budov</h1>
    <p class="page-lead">Jeden dodavatel a jedna odpovědnost za všechny technické profese stavby — od projektu přes montáž po uvedení do provozu a&nbsp;servis.</p>
    <div class="tagrow">
      {PROFESSIONS.map((p) => <Tag variant="inverse">{p}</Tag>)}
    </div>
  </Section>

  <Section bg="var(--palc-grey-50)">
    <SectionHeading overline="Hlavní profese" title="Co dodáváme" />
    <div class="grid3 mt48">
      {mainServices.map((s) => (
        <ServiceCard title={s.title} description={s.desc} href={`/sluzby/${s.slug}/`} />
      ))}
    </div>
  </Section>

  <Section>
    <div class="spec">
      <div>
        <SectionHeading
          overline="Specializované technologie"
          title="Práce, které běžný instalatér nedělá"
          lead="Podtlakové odvodnění střech, jádrové vrtání, technologické rozvody a další specializace pro velké objekty."
        />
        <div class="spec__cta">
          <Button variant="secondary" href="/poptavka/" arrow>Poptat realizaci</Button>
          <Button variant="outline" href="/realizace/">Související realizace</Button>
        </div>
      </div>
      <ImagePlaceholder label="Detail technologie — dodá klient" ratio="4 / 3" />
    </div>
  </Section>
</Base>

<style>
  .page-h1 { color: #fff; font-size: var(--text-3xl); margin-top: 14px; max-width: 760px; }
  .page-lead { color: var(--text-inverse-muted); font-size: var(--text-md); max-width: 620px; margin-top: 18px; }
  .tagrow { display: flex; gap: 8px; margin-top: 28px; flex-wrap: wrap; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .mt48 { margin-top: 48px; }
  .spec { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: center; }
  .spec__cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  @media (max-width: 960px) {
    .grid3 { grid-template-columns: repeat(2, 1fr); }
    .spec { grid-template-columns: 1fr; gap: 32px; }
    .page-h1 { font-size: var(--text-2xl); }
  }
  @media (max-width: 640px) {
    .grid3 { grid-template-columns: 1fr; }
  }
</style>
